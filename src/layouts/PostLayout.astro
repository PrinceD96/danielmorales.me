---
import Layout from "./Layout.astro";
import JsonLdBlogPosting from "@/components/seo/JsonLdBlogPosting.astro";
import JsonLdBreadcrumb from "@/components/seo/JsonLdBreadcrumb.astro";
import { siteConfig } from "@/config/site";
import { readingTimeText, wordCount as getWordCount } from "@/lib/reading-time";
import { postTransitionName } from "@/lib/transitions";
import { Clock, ArrowLeft, ArrowRight, Copy, ChevronUp } from "@lucide/astro";
import LinkedIn from "@/components/icons/LinkedIn.astro";
import X from "@/components/icons/X.astro";

interface AdjacentPost {
  title: string;
  slug: string;
}

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  keywords?: string[];
  coverImage?: string;
  ogImage?: string;
  slug: string;
  body?: string;
  canonicalUrl?: string;
  socialTitle?: string;
  socialDescription?: string;
  prevPost?: AdjacentPost;
  nextPost?: AdjacentPost;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  tags,
  keywords,
  coverImage,
  ogImage,
  slug,
  body,
  canonicalUrl,
  socialTitle,
  socialDescription,
  prevPost,
  nextPost,
} = Astro.props;

const formattedDate = publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const updatedDate = updatedAt?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const readTime = body ? readingTimeText(body) : undefined;
const postWordCount = body ? getWordCount(body) : undefined;
const postUrl = `${siteConfig.url}/blog/${slug}`;

// OG image fallback chain: ogImage > coverImage > generated
const postOgImage = ogImage || coverImage || `/blog/${slug}/og.png`;

const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;
const xShareUrl = `https://x.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(title)}`;
---

<Layout
  title={title}
  description={description}
  type="article"
  publishedAt={publishedAt.toISOString()}
  updatedAt={updatedAt?.toISOString()}
  tags={tags}
  image={postOgImage}
  imageAlt={socialTitle || title}
  canonicalUrl={canonicalUrl}
  socialTitle={socialTitle}
  socialDescription={socialDescription}
>
  <JsonLdBlogPosting
    title={title}
    description={description}
    publishedAt={publishedAt.toISOString()}
    updatedAt={updatedAt?.toISOString()}
    tags={tags}
    keywords={keywords}
    image={postOgImage}
    slug={slug}
    wordCount={postWordCount}
  />
  <JsonLdBreadcrumb
    items={[
      { name: "Blog", url: "/blog" },
      { name: title, url: `/blog/${slug}` },
    ]}
  />

  <article class="pb-8 sm:pb-10">
    <div class="mx-auto max-w-4xl px-6">
      <!-- Header -->
      <header class="mb-12 animate-slide-up">
        <a
          href="/blog"
          class="mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors duration-200 hover:text-primary"
          data-sound="click"
        >
          <ArrowLeft size={14} />
          Blog
        </a>

        <!-- Title -->
        <h1
          class="text-3xl font-bold leading-[1.15] text-primary sm:text-4xl lg:text-5xl"
          transition:name={postTransitionName(slug)}
        >
          {title}
        </h1>

        <!-- Meta row: date, reading time -->
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
          <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
          {updatedDate && (
            <>
              <span class="size-1 rounded-full bg-muted-foreground/40" />
              <span>Updated {updatedDate}</span>
            </>
          )}
          {readTime && (
            <>
              <span class="size-1 rounded-full bg-muted-foreground/40" />
              <span class="inline-flex items-center gap-1.5">
                <Clock size={14} />
                {readTime}
              </span>
            </>
          )}
        </div>
      </header>

      <!-- Content -->
      <div class="prose animate-fade-in" style="animation-delay: 0.1s;">
        <slot />
      </div>

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/blog/tag/${encodeURIComponent(tag)}`}
              class="text-xs text-muted-foreground transition-colors duration-200 hover:text-primary"
            >
              # {tag}
            </a>
          ))}
        </div>
      )}

      <!-- Share buttons -->
      <div class="mt-14 flex items-center gap-3">
        <span class="text-sm text-muted-foreground">Share</span>
        <a
          href={xShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn"
          aria-label="Share on X"
          data-sound="click"
        >
          <X size={16} />
        </a>
        <a
          href={linkedInShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn"
          aria-label="Share on LinkedIn"
          data-sound="click"
        >
          <LinkedIn size={18} />
        </a>
        <button
          type="button"
          class="share-btn"
          aria-label="Copy link to clipboard"
          data-copy-url={postUrl}
          data-sound="copy"
          id="copy-link-btn"
        >
          <Copy size={18} />
        </button>
      </div>

      <!-- Prev / Next navigation -->
      {(prevPost || nextPost) && (
        <nav class="mt-12 grid gap-4 sm:grid-cols-2" aria-label="Adjacent posts">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.slug}`}
              class="group flex flex-col gap-1 transition-colors duration-200"
              data-sound="click"
            >
              <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground transition-colors group-hover:text-foreground">
                <ArrowLeft size={14} />
                Previous
              </span>
              <span class="text-sm font-medium leading-snug text-foreground transition-colors group-hover:text-primary line-clamp-2">
                <span transition:name={postTransitionName(prevPost.slug)}>{prevPost.title}</span>
              </span>
            </a>
          ) : (
            <div />
          )}
          {nextPost ? (
            <a
              href={`/blog/${nextPost.slug}`}
              class="group flex flex-col items-end gap-1 text-right transition-colors duration-200"
              data-sound="click"
            >
              <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground transition-colors group-hover:text-foreground">
                Next
                <ArrowRight size={14} />
              </span>
              <span class="text-sm font-medium leading-snug text-foreground transition-colors group-hover:text-primary line-clamp-2">
                <span transition:name={postTransitionName(nextPost.slug)}>{nextPost.title}</span>
              </span>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )}
    </div>
  </article>

  <!-- Back to Top -->
  <div class="fixed inset-x-0 bottom-32 z-40 pointer-events-none">
    <div class="mx-auto max-w-4xl px-6">
      <button
        type="button"
        id="back-to-top"
        class="pointer-events-auto ml-auto flex size-10 items-center justify-center rounded-full border border-border bg-background/80 text-muted-foreground opacity-0 shadow-sm backdrop-blur-sm transition-all duration-300 hover:bg-muted hover:text-foreground dark:hover:bg-muted/50 cursor-pointer"
        aria-label="Back to top"
        data-sound="click"
      >
        <ChevronUp size={18} />
      </button>
    </div>
  </div>
</Layout>

<script is:inline>
  function initPostLayout() {
    const copyButton = document.getElementById("copy-link-btn");
    if (copyButton && !copyButton.dataset.initialized) {
      copyButton.dataset.initialized = "true";

      copyButton.addEventListener("click", async (e) => {
        const btn = e.currentTarget;
        const url = btn.dataset.copyUrl;
        if (!url || !navigator.clipboard || !window.isSecureContext) return;

        await navigator.clipboard.writeText(url);

        const original = btn.innerHTML;
        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
        btn.classList.add("text-primary", "border-primary/40");
        setTimeout(() => {
          btn.innerHTML = original;
          btn.classList.remove("text-primary", "border-primary/40");
        }, 2000);
      });
    }

    const backToTop = document.getElementById("back-to-top");
    if (backToTop && !backToTop.dataset.initialized) {
      backToTop.dataset.initialized = "true";

      backToTop.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    if (!document.documentElement.dataset.postLayoutScrollBound) {
      document.documentElement.dataset.postLayoutScrollBound = "true";
      window.addEventListener("scroll", () => {
        const currentBackToTop = document.getElementById("back-to-top");
        if (!currentBackToTop) return;

        if (window.scrollY > 400) {
          currentBackToTop.classList.remove("opacity-0", "pointer-events-none");
          currentBackToTop.classList.add("opacity-100");
        } else {
          currentBackToTop.classList.add("opacity-0", "pointer-events-none");
          currentBackToTop.classList.remove("opacity-100");
        }
      }, { passive: true });
    }

    const currentBackToTop = document.getElementById("back-to-top");
    if (currentBackToTop) {
      if (window.scrollY > 400) {
        currentBackToTop.classList.remove("opacity-0", "pointer-events-none");
        currentBackToTop.classList.add("opacity-100");
      } else {
        currentBackToTop.classList.add("opacity-0", "pointer-events-none");
        currentBackToTop.classList.remove("opacity-100");
      }
    }
  }

  if (!document.documentElement.dataset.postLayoutInit) {
    document.documentElement.dataset.postLayoutInit = "true";
    document.addEventListener("astro:page-load", initPostLayout);
  }

  initPostLayout();
</script>
