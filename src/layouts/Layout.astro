---
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/config/site";
import SEO from "@/components/seo/SEO.astro";
import JsonLdWebsite from "@/components/seo/JsonLdWebsite.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedAt?: string;
  updatedAt?: string;
  tags?: string[];
  canonicalUrl?: string;
  socialTitle?: string;
  socialDescription?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />

    <SEO {...props} />
    <JsonLdWebsite />
    <ClientRouter />

    <script is:inline>
      function applyTheme() {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      document.addEventListener("astro:after-swap", applyTheme);
      applyTheme();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-8 sm:pt-10">
      <slot />
    </main>
    <Footer />

    <!-- Sound system: event delegation for [data-sound] and [data-sound-hover] attributes -->
    <script>
      import { playSound } from "@/lib/sounds";

      // Click delegation: any element with data-sound="click" etc.
      document.addEventListener("click", (e) => {
        const target = (e.target as HTMLElement).closest<HTMLElement>("[data-sound]");
        if (!target) return;
        const sound = target.dataset.sound;
        if (sound === "click" || sound === "navigate" || sound === "copy" || sound === "toggle-on" || sound === "toggle-off") {
          playSound(sound);
        }
      });

      // Hover delegation: uses mouseenter with capture phase.
      // SVG re-trigger is prevented via CSS (::before overlay on .social-icon).
      document.addEventListener("mouseenter", (e) => {
        const target = (e.target as HTMLElement).closest<HTMLElement>("[data-sound-hover]");
        if (!target) return;
        const sound = target.dataset.soundHover;
        if (sound === "hover-tick") {
          playSound(sound);
        }
      }, true);
    </script>
  </body>
</html>
