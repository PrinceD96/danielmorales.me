---
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "@/config/site";
import SEO from "@/components/seo/SEO.astro";
import JsonLdWebsite from "@/components/seo/JsonLdWebsite.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedAt?: string;
  updatedAt?: string;
  tags?: string[];
  canonicalUrl?: string;
  socialTitle?: string;
  socialDescription?: string;
  robotsDirective?: "index,follow" | "noindex,follow" | "noindex,nofollow";
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />

    <SEO {...props} />
    <JsonLdWebsite />
    <ClientRouter />

    <script is:inline>
      function applyTheme() {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      document.addEventListener("astro:after-swap", applyTheme);
      applyTheme();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 pt-8 sm:pt-10">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      if (!window.__siteAudioBound) {
        window.__siteAudioBound = true;

        var siteAudioContext = null;
        var AudioContextClass = window.AudioContext || window["webkitAudioContext"];

        function getSiteAudioContext() {
          if (siteAudioContext || !AudioContextClass) return siteAudioContext;
          try {
            siteAudioContext = new AudioContextClass();
          } catch {
            siteAudioContext = null;
          }
          return siteAudioContext;
        }

        function siteSoundsEnabled() {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return false;
          return localStorage.getItem("sounds") !== "off";
        }

        function playSiteTone(configure, duration) {
          if (!siteSoundsEnabled()) return;
          var audio = getSiteAudioContext();
          if (!audio) return;
          if (audio.state === "suspended") audio.resume();

          var time = audio.currentTime;
          var osc = audio.createOscillator();
          var gain = audio.createGain();
          osc.type = "sine";
          configure(osc, gain, time);
          osc.connect(gain).connect(audio.destination);
          osc.start(time);
          osc.stop(time + duration);
        }

        window.__playSiteSound = function (name) {
          switch (name) {
            case "click":
              playSiteTone(function (osc, gain, time) {
                osc.frequency.setValueAtTime(800, time);
                gain.gain.setValueAtTime(0.3, time);
                gain.gain.exponentialRampToValueAtTime(0.001, time + 0.05);
              }, 0.05);
              break;
            case "toggle-on":
            case "toggle-off":
              playSiteTone(function (osc, gain, time) {
                var up = name === "toggle-on";
                osc.frequency.setValueAtTime(up ? 600 : 1000, time);
                osc.frequency.exponentialRampToValueAtTime(up ? 1000 : 600, time + 0.08);
                gain.gain.setValueAtTime(0.3, time);
                gain.gain.exponentialRampToValueAtTime(0.001, time + 0.08);
              }, 0.08);
              break;
            case "copy":
              if (!siteSoundsEnabled()) return;
              var audio = getSiteAudioContext();
              if (!audio) return;
              if (audio.state === "suspended") audio.resume();

              var time = audio.currentTime;
              var osc1 = audio.createOscillator();
              var gain1 = audio.createGain();
              osc1.type = "sine";
              osc1.frequency.setValueAtTime(880, time);
              gain1.gain.setValueAtTime(0.24, time);
              gain1.gain.exponentialRampToValueAtTime(0.001, time + 0.1);
              osc1.connect(gain1).connect(audio.destination);
              osc1.start(time);
              osc1.stop(time + 0.1);

              var osc2 = audio.createOscillator();
              var gain2 = audio.createGain();
              osc2.type = "sine";
              osc2.frequency.setValueAtTime(1320, time + 0.04);
              gain2.gain.setValueAtTime(0, time);
              gain2.gain.setValueAtTime(0.18, time + 0.04);
              gain2.gain.exponentialRampToValueAtTime(0.001, time + 0.12);
              osc2.connect(gain2).connect(audio.destination);
              osc2.start(time);
              osc2.stop(time + 0.12);
              break;
            case "navigate":
              playSiteTone(function (osc, gain, time) {
                osc.frequency.setValueAtTime(500, time);
                osc.frequency.exponentialRampToValueAtTime(400, time + 0.04);
                gain.gain.setValueAtTime(0.21, time);
                gain.gain.exponentialRampToValueAtTime(0.001, time + 0.04);
              }, 0.04);
              break;
            case "hover-tick":
              playSiteTone(function (osc, gain, time) {
                osc.frequency.setValueAtTime(600, time);
                osc.frequency.exponentialRampToValueAtTime(1200, time + 0.025);
                gain.gain.setValueAtTime(0.06, time);
                gain.gain.exponentialRampToValueAtTime(0.001, time + 0.025);
              }, 0.025);
              break;
          }
        };

        document.addEventListener("click", function (event) {
          var target = event.target && event.target.closest ? event.target.closest("[data-sound]") : null;
          var sound = target && target.dataset ? target.dataset.sound : null;
          if (sound) window.__playSiteSound(sound);
        });

        document.addEventListener("mouseenter", function (event) {
          var target = event.target && event.target.closest ? event.target.closest("[data-sound-hover]") : null;
          var sound = target && target.dataset ? target.dataset.soundHover : null;
          if (sound) window.__playSiteSound(sound);
        }, true);
      }
    </script>
  </body>
</html>
