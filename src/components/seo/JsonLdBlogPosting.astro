---
import { siteConfig } from "@/config/site";

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  tags?: string[];
  keywords?: string[];
  image?: string;
  slug: string;
  wordCount?: number;
}

const { title, description, publishedAt, updatedAt, tags, keywords, image, slug, wordCount } =
  Astro.props;
const url = `${siteConfig.url}/blog/${slug}`;
const schemaKeywords = keywords?.length ? keywords : tags;
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": url,
    },
    datePublished: publishedAt,
    ...(updatedAt && { dateModified: updatedAt }),
    ...(image && { image: new URL(image, siteConfig.url).href }),
    ...(schemaKeywords?.length && { keywords: schemaKeywords.join(", ") }),
    ...(wordCount && { wordCount }),
    inLanguage: "en-US",
    author: {
      "@type": "Person",
      "@id": `${siteConfig.url}/#person`,
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
    publisher: {
      "@type": "Person",
      "@id": `${siteConfig.url}/#person`,
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
    isPartOf: {
      "@id": `${siteConfig.url}/#website`,
    },
  })}
/>
