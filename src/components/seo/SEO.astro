---
import { siteConfig } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedAt?: string;
  updatedAt?: string;
  tags?: string[];
  canonicalUrl?: string;
  socialTitle?: string;
  socialDescription?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = "website",
  publishedAt,
  updatedAt,
  tags,
  canonicalUrl,
  socialTitle,
  socialDescription,
  noindex = false,
} = Astro.props;

const withVersion = (url: string, version?: string) => {
  const absoluteUrl = new URL(url, siteConfig.url);

  if (version) {
    absoluteUrl.searchParams.set("v", version);
  }

  return absoluteUrl.href;
};

const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.title;
const ogTitle = socialTitle || title || siteConfig.title;
const ogDescription = socialDescription || description;
const ogImage = image
  ? withVersion(image)
  : withVersion(siteConfig.ogImage, siteConfig.ogImageVersion);
const ogImageAlt = imageAlt || ogTitle;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteConfig.url).href;

// noindex on non-production environments
const isProduction = import.meta.env.PROD;
const shouldNoindex = noindex || !isProduction;
---

<title>{pageTitle}</title>
<meta name="description" content={ogDescription} />
<meta name="author" content={siteConfig.author.name} />
<link rel="canonical" href={canonical} />

{shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteConfig.name} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:secure_url" content={ogImage} />}
{ogImage && <meta property="og:image:type" content="image/png" />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@Princedany96" />
<meta name="twitter:creator" content="@Princedany96" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
