---
import type { CollectionEntry } from "astro:content";
import { siteConfig } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedAt?: string;
  updatedAt?: string;
  tags?: string[];
  canonicalUrl?: string;
  socialTitle?: string;
  socialDescription?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  type = "website",
  publishedAt,
  updatedAt,
  tags,
  canonicalUrl,
  socialTitle,
  socialDescription,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.title;
const ogTitle = socialTitle || title || siteConfig.title;
const ogDescription = socialDescription || description;
const ogImage = image
  ? new URL(image, siteConfig.url).href
  : undefined;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteConfig.url).href;

// noindex on non-production environments
const isProduction = import.meta.env.PROD;
const shouldNoindex = noindex || !isProduction;
---

<title>{pageTitle}</title>
<meta name="description" content={ogDescription} />
<meta name="author" content={siteConfig.author.name} />
<link rel="canonical" href={canonical} />

{shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteConfig.name} />
{ogImage && <meta property="og:image" content={ogImage} />}
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
