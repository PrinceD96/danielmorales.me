---
import { Volume2, VolumeOff } from "@lucide/astro";
---

<button
  type="button"
  id="sound-toggle"
  class="relative flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors duration-200 cursor-pointer hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
  aria-label="Toggle sounds"
  transition:persist
>
  <span id="sound-on-icon" class="absolute">
    <Volume2 size={16} />
  </span>
  <span id="sound-off-icon" class="absolute rotate-90 scale-0 opacity-0">
    <VolumeOff size={16} />
  </span>
</button>

<script>
  function initSoundToggle() {
    const btn = document.getElementById("sound-toggle");
    const onIcon = document.getElementById("sound-on-icon");
    const offIcon = document.getElementById("sound-off-icon");
    if (!btn || !onIcon || !offIcon) return;

    // Avoid duplicate listeners on persisted element
    if (btn.dataset.initialized) return;
    btn.dataset.initialized = "true";

    function updateIcons(enabled: boolean, animate: boolean) {
      const transition = animate ? "transition-all duration-300" : "";
      if (enabled) {
        onIcon!.className = `absolute ${transition} rotate-0 scale-100 opacity-100`;
        offIcon!.className = `absolute ${transition} rotate-90 scale-0 opacity-0`;
        btn!.setAttribute("aria-label", "Mute sounds");
      } else {
        onIcon!.className = `absolute ${transition} -rotate-90 scale-0 opacity-0`;
        offIcon!.className = `absolute ${transition} rotate-0 scale-100 opacity-100`;
        btn!.setAttribute("aria-label", "Enable sounds");
      }
    }

    // Set initial state without animation
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const pref = localStorage.getItem("sounds");
    const enabled = !reducedMotion && pref !== "off";
    updateIcons(enabled, false);

    btn.addEventListener("click", () => {
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reducedMotion) return;

      const current = localStorage.getItem("sounds");
      const isCurrentlyOn = current !== "off";
      const next = isCurrentlyOn ? "off" : "on";
      localStorage.setItem("sounds", next);
      updateIcons(next === "on", true);
    });
  }

  initSoundToggle();
  document.addEventListener("astro:after-swap", initSoundToggle);
</script>
