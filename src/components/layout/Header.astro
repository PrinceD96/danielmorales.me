---
import { siteConfig } from "@/config/site";
import ThemeToggle from "@/components/ui/theme-toggle.astro";
import SoundToggle from "@/components/ui/sound-toggle.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-background">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5">
    <a
      href="/"
      class="text-lg tracking-tight text-foreground"
      data-sound="navigate"
    >
      {siteConfig.name}
    </a>

    <div class="flex items-center gap-1">
      {siteConfig.nav.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + "/");
        return (
          <a
            href={item.href}
            data-sound="click"
            class:list={[
              "px-3 py-1.5 text-sm transition-colors duration-200",
              isActive
                ? "text-foreground font-medium"
                : "text-muted-foreground hover:text-primary",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <SoundToggle />
      <ThemeToggle />
    </div>
  </nav>
  <div class="mx-auto max-w-4xl px-6">
    <hr class="border-border" />
  </div>
  <!-- Reading progress bar -->
  <div
    id="reading-progress"
    class="h-1 origin-left bg-primary transition-opacity duration-300"
    style="transform: scaleX(0); opacity: 0;"
  ></div>
</header>

<script is:inline>
  function updateProgress() {
    const bar = document.getElementById("reading-progress");
    if (!bar) return;

    const path = window.location.pathname;
    const isBlogPost = path.startsWith("/blog/") && !path.startsWith("/blog/tag/") && path !== "/blog/";

    if (!isBlogPost) {
      bar.style.opacity = "0";
      bar.style.transform = "scaleX(0)";
      return;
    }

    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight <= 0) {
      bar.style.opacity = "0";
      return;
    }

    const pct = Math.min(window.scrollY / docHeight, 1);
    bar.style.transform = `scaleX(${pct})`;
    bar.style.opacity = window.scrollY > 80 ? "1" : "0";
  }

  if (!document.documentElement.dataset.readingProgressBound) {
    document.documentElement.dataset.readingProgressBound = "true";
    window.addEventListener("scroll", updateProgress, { passive: true });
    document.addEventListener("astro:page-load", updateProgress);
  }

  updateProgress();
</script>
