---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import JsonLdCollection from "@/components/seo/JsonLdCollection.astro";
import JsonLdBreadcrumb from "@/components/seo/JsonLdBreadcrumb.astro";
import TagList from "@/components/blog/TagList.astro";
import { siteConfig } from "@/config/site";
import { readingTimeText } from "@/lib/reading-time";

const posts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sorted = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

// Collect all unique tags
const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();

// Filter by tag if query param present
const activeTag = Astro.url.searchParams.get("tag") ?? undefined;
const filtered = activeTag
  ? sorted.filter((p) => p.data.tags.includes(activeTag))
  : sorted;

// JSON-LD items
const collectionItems = filtered.map((post, i) => ({
  title: post.data.title,
  url: `${siteConfig.url}/blog/${post.id}`,
  position: i + 1,
}));
---

<Layout
  title="Blog"
  description="Essays on building software products, engineering decisions, and the craft of shipping useful things."
>
  <JsonLdCollection
    name="Blog"
    description="Essays on building software products, engineering decisions, and the craft of shipping useful things."
    items={collectionItems}
  />
  <JsonLdBreadcrumb items={[{ name: "Blog", url: "/blog" }]} />

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <header class="mb-12">
        <h1 class="text-3xl font-bold sm:text-4xl">Blog</h1>
        <p class="mt-3 text-muted-foreground">
          Essays on building software products and what I learn along the way.
        </p>
      </header>

      {allTags.length > 0 && (
        <div class="mb-10">
          <TagList tags={allTags} activeTag={activeTag} />
        </div>
      )}

      {filtered.length > 0 ? (
        <div class="space-y-10">
          {filtered.map((post) => {
            const { title, description, publishedAt, tags } = post.data;
            const formattedDate = publishedAt.toLocaleDateString("en-US", {
              day: "numeric",
              month: "short",
              year: "numeric",
            });
            const readTime = post.body ? readingTimeText(post.body) : undefined;
            return (
              <article>
                <a href={`/blog/${post.id}`} class="group block">
                  <h2
                    class="text-xl font-medium leading-snug text-foreground decoration-dashed underline-offset-4 transition-all duration-200 group-hover:text-primary group-hover:underline group-hover:decoration-primary/30 sm:text-2xl"
                    transition:name={`post-title-${post.id}`}
                  >
                    {title}
                  </h2>
                  <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                    <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
                    {readTime && (
                      <>
                        <span>&middot;</span>
                        <span>{readTime}</span>
                      </>
                    )}
                    {tags && tags.length > 0 && (
                      <>
                        <span>&middot;</span>
                        {tags.map((tag) => (
                          <span># {tag}</span>
                        ))}
                      </>
                    )}
                  </div>
                  <p class="mt-2 leading-relaxed text-muted-foreground">
                    {description}
                  </p>
                </a>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="text-muted-foreground">No essays found.</p>
      )}
    </div>
  </section>
</Layout>
