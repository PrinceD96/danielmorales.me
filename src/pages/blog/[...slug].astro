---
import { getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const sorted = posts.sort(
    (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  );

  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: i < sorted.length - 1 ? sorted[i + 1] : undefined,
      nextPost: i > 0 ? sorted[i - 1] : undefined,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  coverImage={post.data.coverImage}
  slug={post.id}
  body={post.body ?? ""}
  canonicalUrl={post.data.canonicalUrl}
  socialTitle={post.data.socialTitle}
  socialDescription={post.data.socialDescription}
  prevPost={prevPost ? { title: prevPost.data.title, slug: prevPost.id } : undefined}
  nextPost={nextPost ? { title: nextPost.data.title, slug: nextPost.id } : undefined}
>
  <Content />
</PostLayout>
