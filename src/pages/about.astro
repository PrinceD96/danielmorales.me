---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="About" description="About Daniel Morales — software engineer, builder, writer.">
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <div class="max-w-2xl">
        <h1 class="mb-8">About</h1>

        <blockquote class="mb-8 border-l-2 border-primary/40 pl-5">
          <p class="text-xl font-light leading-relaxed text-foreground/90 italic sm:text-2xl">
            &ldquo;Writing forces precision. Shipping forces prioritization. Doing both compounds over time.&rdquo;
          </p>
        </blockquote>

        <div class="space-y-4 leading-relaxed text-muted-foreground">
          <p>
            I&rsquo;m a software engineer who builds products on the side. This site is where I write about
            what I learn&thinsp;&mdash;&thinsp;engineering decisions, product thinking, and the craft of shipping useful software.
          </p>
          <p>
            I believe the best way to learn is to build real things and explain them clearly.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
