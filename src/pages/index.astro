---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import danielImage from "@/assets/daniel-morales.webp";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config/site";
import { readingTimeText } from "@/lib/reading-time";
import GitHub from "@/components/icons/GitHub.astro";
import X from "@/components/icons/X.astro";
import LinkedIn from "@/components/icons/LinkedIn.astro";
import Email from "@/components/icons/Email.astro";
import RSS from "@/components/icons/RSS.astro";

const posts = await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sorted = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const recentPosts = sorted.slice(0, 10);
---

<Layout>
  <!-- Intro -->
  <section class="pb-4 sm:pb-6">
    <div class="mx-auto max-w-4xl px-6">
      <div class="flex flex-col items-center gap-8 text-center sm:flex-row sm:items-center sm:gap-12 sm:text-left">
        <div class="relative shrink-0">
          <Image
            src={danielImage}
            alt={siteConfig.name}
            class="h-40 w-40 rounded-full object-cover shadow-xl border-2 border-background dark:border-white/10"
            width={320}
            height={320}
            loading="eager"
          />
        </div>
        <div class="flex-1">
          <h1 class="text-3xl font-bold sm:text-4xl">
            Hi, I'm {siteConfig.name.split(" ")[0]}.
          </h1>
          <p class="mt-3 max-w-lg leading-relaxed text-muted-foreground">
            {siteConfig.description}
          </p>
          <div class="mt-4 flex items-center justify-center gap-1 sm:justify-start">
            <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
              <GitHub size={18} />
            </a>
            <a href={siteConfig.social.x} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="X">
              <X size={18} />
            </a>
            <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
              <LinkedIn size={18} />
            </a>
            <a href={`mailto:${siteConfig.social.email}`} class="social-icon" aria-label="Email">
              <Email size={18} />
            </a>
            <a href="/rss.xml" class="social-icon" aria-label="RSS Feed">
              <RSS size={18} />
            </a>
          </div>
        </div>
      </div>
      <hr class="mt-12 border-border" />
    </div>
  </section>

  <!-- Posts -->
  <section class="pt-8 pb-12 sm:pb-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="space-y-10">
        {recentPosts.map((post) => {
          const { title, description, publishedAt } = post.data;
          const formattedDate = publishedAt.toLocaleDateString("en-US", {
            day: "numeric",
            month: "short",
            year: "numeric",
          });
          const readTime = post.body ? readingTimeText(post.body) : undefined;
          return (
            <article>
              <a href={`/blog/${post.id}`} class="group block">
                <h2
                  class="text-xl font-medium leading-snug text-primary decoration-dashed underline-offset-4 transition-all duration-200 group-hover:underline group-hover:decoration-primary/30 sm:text-2xl"
                  transition:name={`post-title-${post.id}`}
                >
                  {title}
                </h2>
                <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                  <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
                  {readTime && (
                    <>
                      <span>&middot;</span>
                      <span>{readTime}</span>
                    </>
                  )}
                </div>
                <p class="mt-2 leading-relaxed text-muted-foreground">
                  {description}
                </p>
              </a>
            </article>
          );
        })}
      </div>

      {sorted.length > 10 && (
        <div class="mt-12 text-center">
          <a
            href="/blog"
            class="text-sm text-muted-foreground transition-colors hover:text-primary"
          >
            All Posts &rarr;
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>
