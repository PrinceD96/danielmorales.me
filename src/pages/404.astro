---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not Found" description="The page you're looking for doesn't exist." noindex>
  <section class="flex flex-1 items-center justify-center py-24 sm:py-32">
    <div class="mx-auto max-w-md px-6 text-center">
      <p class="text-sm font-medium uppercase tracking-widest text-muted-foreground">404</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">Page not found</h1>
      <p class="mt-4 text-muted-foreground">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="mt-8 inline-block rounded-md border border-border px-6 py-2.5 text-sm text-foreground transition-colors hover:bg-muted"
      >
        Go home
      </a>
    </div>
  </section>
</Layout>
