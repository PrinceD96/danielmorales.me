{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "danielmorales-me",
	"compatibility_date": "2025-10-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
			"routes": [
				{
					"pattern": "staging.danielmorales.me",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1
			}
		},
		"production": {
			"routes": [
				{
					"pattern": "danielmorales.me",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true,
				"head_sampling_rate": 0.1
			}
		}
	}
}
